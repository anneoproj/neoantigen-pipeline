params {
    maf_glob = "data/mafs/*.csv"
    neopep_input = null
    existing_candidates_glob = "data/input/*_lt500.csv"
    hla_dir = "data/netmhcpan_input"
    expression_dir = "data/expressions"
    netmhcpan_chunk_size = 2000
    netmhcpan_max_forks = 4
    mhcflurry_max_forks = 1
    mhcnuggets_max_forks = 1
    pssmhcpan_max_forks = 1
}

process {
    executor = 'local'

    withName: NETMHCPAN {
        maxForks = params.netmhcpan_max_forks
    }
    withName: NEOPEP_NETMHCPAN {
        maxForks = params.netmhcpan_max_forks
    }
    withName: MHCFLURRY {
        maxForks = params.mhcflurry_max_forks
    }
    withName: EXISTING_MHCFLURRY {
        maxForks = params.mhcflurry_max_forks
    }
    withName: NEOPEP_MHCFLURRY {
        maxForks = params.mhcflurry_max_forks
    }
    withName: MHCNUGGETS {
        maxForks = params.mhcnuggets_max_forks
    }
    withName: EXISTING_MHCNUGGETS {
        maxForks = params.mhcnuggets_max_forks
    }
    withName: NEOPEP_MHCNUGGETS {
        maxForks = params.mhcnuggets_max_forks
    }
    withName: PSSMHCPAN {
        maxForks = params.pssmhcpan_max_forks
    }
    withName: EXISTING_PSSMHCPAN {
        maxForks = params.pssmhcpan_max_forks
    }
    withName: NEOPEP_PSSMHCPAN {
        maxForks = params.pssmhcpan_max_forks
    }
}
docker {
    enabled = true
}
